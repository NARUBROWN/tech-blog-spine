SPINE_PORT=8080

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=tech_blog
MYSQL_USER=tech_blog
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-root-password

REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false

# 32바이트 이상의 무작위 값을 사용하세요.
JWT_SECRET=change-me-to-at-least-32-random-bytes

IMAGE_UPLOAD_DIR=./images
ALLOWED_ORIGINS=http://localhost:5173

# 로컬 HTTP에서만 false로 설정하고 운영에서는 true를 유지하세요.
COOKIE_SECURE=true
